# Database connection — replace with your local MySQL credentials
DATABASE_URL=mysql+pymysql://YOUR_USERNAME:YOUR_PASSWORD@localhost:3306/kaavalal

# Authentication — generate a separate secret for each environment
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET

# OpenWeather current conditions (set this in backend/.env; never commit the key)
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

# Admin site
ADMIN_JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
ADMIN_APP_ORIGIN=http://localhost:5175

# Optional authenticated SMTP for password reset email. Example Gmail settings:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-sender@gmail.com
# SMTP_PASSWORD=your-16-character-Google-app-password
# SMTP_FROM_EMAIL=your-sender@gmail.com
# SMTP_USE_TLS=true
# Gmail requires 2-Step Verification before creating an app password.
# Never commit your actual .env or share its SMTP password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
FRONTEND_BASE_URL=http://127.0.0.1:5173

# Thunai disaster assistant. Add your Gemini API key from Google AI Studio.
CHATBOT_PROVIDER=gemini
CHATBOT_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY
CHATBOT_KB_DIR=./app/chatbot/knowledge
CHATBOT_VECTOR_DIR=./chatbot_vectorstore
CHATBOT_RATE_LIMIT=20/minute
CHATBOT_KSDMA_DATA_READY=false

